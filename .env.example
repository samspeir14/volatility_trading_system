TRADIER_ENV=sandbox
TRADIER_API_KEY=your_token_here
TRADIER_ACCOUNT_ID=VA00000000
# TRADIER_BASE_URL=  # optional override (otherwise derived from TRADIER_ENV)
# MODEL_PIPELINE=h1  # "h1" (default: next-day within-stock deviation model,
#                    # term-projected to each option's tenor, VRP z-gated) or
#                    # "legacy" (the old 5/10/21-horizon models, comparison only)
# ACCOUNT_PROFILE=standard  # "standard" (~$100k calibration + main watchlist)
#                    # or "small" (~$10k: watchlist_small.yaml, retuned risk caps)
# VRP_Z_SELL=1.5     # SELL needs gap z >= this vs the ticker's own history
# VRP_Z_BUY=1.25     # BUY needs gap z <= -this (lower bar: long-vol loss bounded)
# VRP_MIN_OBS=120    # min daily gap observations before a ticker can signal
# COST_MULT=2.0      # expected edge must cover this multiple of spread+fee cost
# MAX_SPREAD_PCT=0.05  # block entry if any leg quotes wider than this vs mid
# EARNINGS_EXIT_BUFFER_DAYS=1  # close short vol >= this many trading days pre-earnings
# PER_CONTRACT_FEE=    # estimated cost per option contract per side, netted
#                      # out of realized P&L. Leave unset (0.0) on paper.
#                      # Live on Tradier: 0.10 on the Pro plan (regulatory
#                      # pass-throughs), 0.45 on Lite ($0.35 commission + fees)
