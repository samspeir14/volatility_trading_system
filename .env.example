TRADIER_ENV=sandbox
TRADIER_API_KEY=your_token_here
TRADIER_ACCOUNT_ID=VA00000000
# TRADIER_BASE_URL=  # optional override (otherwise derived from TRADIER_ENV)
# STRATEGY_MODE=model  # "model" (trade model-vs-IV divergence), "harvest"
#                      # (sell short-DTE iron condors unconditionally; the
#                      # model still runs and logs for accuracy tracking), or
#                      # "small_harvest" (harvest strategy calibrated for a
#                      # ~$10k bankroll: cheap-ticker watchlist_small.yaml,
#                      # 2.5% per-trade budget, $0.25 min credit)
# PER_CONTRACT_FEE=    # estimated cost per option contract per side, netted
#                      # out of realized P&L. Leave unset (0.0) on paper.
#                      # Live on Tradier: 0.10 on the Pro plan (regulatory
#                      # pass-throughs), 0.45 on Lite ($0.35 commission + fees)
